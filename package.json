{
  "name": "apex-commerce",
  "version": "1.0.0",
  "description": "APEX Digital Solutions - Multi-tenant E-commerce SaaS Platform",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && node --watch src/index.js",
    "dev:frontend": "cd frontend && npx vite",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "cd frontend && npm install && npx vite build",
    "start": "NODE_ENV=production node backend/src/index.js",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "setup:db": "node backend/src/db/setup.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
